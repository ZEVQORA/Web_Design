# ZEVQORA website - public configuration.
#
# Copy to .env.local for local development. Never commit a real .env file;
# .gitignore already excludes them.
#
# The website has no secrets today. Everything below is public by definition
# (NEXT_PUBLIC_* is inlined into the client bundle), so nothing here is
# sensitive - and nothing that IS sensitive belongs in this file.

# Set to "true" only once a real auth backend is wired up behind
# lib/authClient.ts. Left unset, production resolves every auth action to a
# visible "not connected" state instead of pretending an account was created.
NEXT_PUBLIC_AUTH_CONFIGURED=false
